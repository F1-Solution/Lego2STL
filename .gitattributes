* text=auto eol=crlf

*.csv text eol=lf
*.md  text eol=lf

# Anything a Unix system runs or reads must keep its line endings. A shell script checked out
# with carriage returns fails at the first line with "bad interpreter", and a desktop entry
# with them is ignored; both are baffling to debug from a Windows machine, because the file
# looks perfectly fine there.
*.sh      text eol=lf
*.desktop text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.plist   text eol=lf
*.xml     text eol=lf

# The installer script a Mac runs before unpacking. It has no extension, so no rule above
# reaches it, and it is the one file here where carriage returns would be fatal.
packaging/macos/preinstall text eol=lf

*.pdf binary
*.png binary
*.jpg binary
*.stl binary
*.3mf binary
*.zip binary
*.dat binary
*.msi binary
*.rtf binary

# Kept copies of what the tool produces. The text ones are compared with line endings
# normalised, so either kind is safe; the rest are compared byte for byte and must not be
# touched at all.
tests/Lego2STL.Tests/Snapshots/*.stl binary
tests/Lego2STL.Tests/Snapshots/*.3mf binary
