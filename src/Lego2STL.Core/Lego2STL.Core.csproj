  <ItemGroup>
    <!--
      The colour cross-reference ships inside the assembly so a normal run needs no API
      key and no network. Generated by 'lego2stl refresh-colors'; the glob matching
      nothing is not an error, which is what makes the first bootstrap build possible.
    -->
    <EmbeddedResource Include="Data\*.csv" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
  </ItemGroup>

</Project>
