<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lego2STL.Gui.ViewModels"
             xmlns:loc="using:Lego2STL.Gui.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="560"
             x:Class="Lego2STL.Gui.Views.CatalogueView"
             x:DataType="vm:RunDocumentViewModel">

  <DockPanel>

    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">

      <!-- No heading: the run's own header names it, and a second one would only repeat. -->
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Classes="label"
                   Text="{Binding [UiFilterByColour], Source={x:Static loc:Loc.Current}}" />
        <ComboBox MinWidth="200"
                  PlaceholderText="{Binding [UiAllColours], Source={x:Static loc:Loc.Current}}"
                  ItemsSource="{Binding Colours}"
                  SelectedItem="{Binding ColourFilter}" />
        <Button Name="ClearFilter" Content="✕" ToolTip.Tip="{Binding [UiAllColours], Source={x:Static loc:Loc.Current}}" />
        <TextBox MinWidth="220" PlaceholderText="32523" Text="{Binding Search}" />
        <TextBlock Classes="label" VerticalAlignment="Center"
                   Text="{Binding [UiNumbering], Source={x:Static loc:Loc.Current}}" />
        <ComboBox MinWidth="200" SelectedItem="{Binding SelectedNumbering}"
                  ItemsSource="{Binding Numberings}" />
      </StackPanel>

      <!-- Asked above the cards, one at a time, over a run that has already finished. -->
      <Border Padding="12,10" CornerRadius="4"
              Background="{DynamicResource AppWarningBand}"
              BorderBrush="{DynamicResource AppWarningBorder}"
              BorderThickness="1"
              IsVisible="{Binding HasQuestions}">
        <StackPanel Spacing="8">

          <TextBlock FontWeight="SemiBold" TextWrapping="Wrap"
                     Foreground="{DynamicResource AppWarningText}"
                     Text="{Binding [UiCouldNotRead], Source={x:Static loc:Loc.Current}}" />

          <!-- The piece of page itself, which is the whole of what is being asked about. -->
          <Border Background="White" CornerRadius="3" Padding="4" HorizontalAlignment="Left"
                  IsVisible="{Binding CurrentQuestion.HasPicture}">
            <Image Source="{Binding CurrentQuestion.Picture}" Stretch="Uniform"
                   MaxHeight="140" MaxWidth="760" />
          </Border>

          <!-- What the recogniser did return, which is often half the answer already. -->
          <TextBlock Classes="hint" TextWrapping="Wrap" FontFamily="monospace"
                     Text="{Binding CurrentQuestion.RawText}" />

          <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" ColumnSpacing="8">
            <TextBlock Grid.Column="0" Classes="label" VerticalAlignment="Center"
                       Text="{Binding [UiWhichPart], Source={x:Static loc:Loc.Current}}" />
            <TextBox Grid.Column="1" Name="AnswerPart" PlaceholderText="32523"
                     Text="{Binding CurrentQuestion.PartNumber, Mode=TwoWay}" />
            <TextBlock Grid.Column="2" Classes="label" VerticalAlignment="Center"
                       Text="{Binding [UiWhichColour], Source={x:Static loc:Loc.Current}}" />
            <TextBox Grid.Column="3" Name="AnswerColour" PlaceholderText="11"
                     Text="{Binding CurrentQuestion.ColorCode, Mode=TwoWay}" />
            <TextBlock Grid.Column="4" Classes="label" VerticalAlignment="Center"
                       Text="{Binding [UiHowMany], Source={x:Static loc:Loc.Current}}" />
            <TextBox Grid.Column="5" Name="AnswerQuantity" PlaceholderText="4"
                     Text="{Binding CurrentQuestion.Quantity, Mode=TwoWay}" />
          </Grid>

          <!-- Three equal thirds, so a longer wording in another language still fits. -->
          <Grid ColumnDefinitions="*,6,*,6,*">
            <Button Grid.Column="0" Name="AnswerOk"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding CurrentQuestion.AcceptCommand}"
                    IsEnabled="{Binding CurrentQuestion.CanAccept}"
                    Content="{Binding [UiAnswerOk], Source={x:Static loc:Loc.Current}}" />
            <Button Grid.Column="2" Name="AnswerSkip"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding CurrentQuestion.SkipCommand}"
                    Content="{Binding [UiAnswerSkip], Source={x:Static loc:Loc.Current}}" />
            <Button Grid.Column="4" Name="AnswerNotALegoCode"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding CurrentQuestion.NotAnEntryCommand}"
                    Content="{Binding [UiAnswerNotALegoCode], Source={x:Static loc:Loc.Current}}" />
          </Grid>

        </StackPanel>
      </Border>

      <!-- Said once, above the cards, because it is about the run rather than about one part. -->
      <Border Padding="12,10" CornerRadius="4"
              Background="{DynamicResource AppWarningBand}"
              BorderBrush="{DynamicResource AppWarningBorder}"
              BorderThickness="1"
              IsVisible="{Binding HasPartsThatDoNotFit}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" TextWrapping="Wrap" VerticalAlignment="Center"
                     Foreground="{DynamicResource AppWarningText}"
                     Text="{Binding DoesNotFitText}" />
          <Button Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                  Command="{Binding TryASmallerScaleCommand}"
                  Content="{Binding TryASmallerScaleText}" />
        </Grid>
      </Border>

    </StackPanel>

    <TextBlock DockPanel.Dock="Top" Classes="hint" Margin="0,0,0,8"
               IsVisible="{Binding !Parts.Count}"
               Text="{Binding [UiCatalogueEmpty], Source={x:Static loc:Loc.Current}}" />

    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding VisibleParts}">

        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:CataloguePartViewModel">

            <Border Classes="card" Width="264" Margin="0,0,10,10">
              <StackPanel Spacing="6">

                <!-- The part, in its colour. A swatch stands in when there is no picture. -->
                <Panel Height="104">
                  <Border Background="{Binding Swatch}" CornerRadius="4"
                          IsVisible="{Binding Picture, Converter={x:Static ObjectConverters.IsNull}}" />
                  <Image Source="{Binding Picture}" Stretch="Uniform"
                         IsVisible="{Binding Picture, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </Panel>

                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Border Grid.Column="0" Width="14" Height="14" CornerRadius="3"
                          VerticalAlignment="Center" Margin="0,0,8,0"
                          Background="{Binding Swatch}"
                          BorderThickness="1"
                          BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" />
                  <TextBlock Grid.Column="1" FontWeight="SemiBold"
                             Text="{Binding ShownNumber}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2" Text="{Binding Quantity, StringFormat='x{0}'}" />
                </Grid>

                <TextBlock Classes="hint" Text="{Binding ColorName}" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="hint" Text="{Binding Size}" />

                <!-- Opaque per theme: an alpha over an unknown surface goes muddy in dark. -->
                <Border Background="{DynamicResource AppWarningBand}"
                        BorderBrush="{DynamicResource AppWarningBorder}"
                        BorderThickness="1"
                        CornerRadius="3" Padding="6,4"
                        IsVisible="{Binding HasWarning}">
                  <TextBlock FontSize="11" TextWrapping="Wrap"
                             Foreground="{DynamicResource AppWarningText}"
                             Text="{Binding WarningText}" />
                </Border>

                <!-- Two equal halves, so a longer wording in another language still fits. -->
                <Grid ColumnDefinitions="*,6,*">
                  <Button Grid.Column="0" FontSize="11" Padding="6,4"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                          Command="{Binding OpenShapeCommand}"
                          IsEnabled="{Binding HasShapeFile}"
                          Content="{Binding [UiOpenShapeFile], Source={x:Static loc:Loc.Current}}" />
                  <Button Grid.Column="2" FontSize="11" Padding="6,4"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                          Command="{Binding OpenPlateCommand}"
                          IsEnabled="{Binding HasPlateFile}"
                          Content="{Binding [UiOpenPlate], Source={x:Static loc:Loc.Current}}" />
                </Grid>

                <!-- Only on a part the run did not build: the one card with something to buy. -->
                <Button FontSize="11" Padding="6,4"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        IsVisible="{Binding CanBuy}"
                        Command="{Binding BuyCommand}"
                        Content="{Binding BuyText}" />

              </StackPanel>
            </Border>

          </DataTemplate>
        </ItemsControl.ItemTemplate>

      </ItemsControl>
    </ScrollViewer>

  </DockPanel>

</UserControl>
