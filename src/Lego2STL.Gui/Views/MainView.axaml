<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lego2STL.Gui.ViewModels"
             xmlns:loc="using:Lego2STL.Gui.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="720"
             x:Class="Lego2STL.Gui.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="{DynamicResource AppWindowBackground}">

  <UserControl.Styles>
    <Style Selector="TextBlock.heading">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,12" />
      <Setter Property="Foreground" Value="{DynamicResource AppText}" />
    </Style>
    <Style Selector="TextBlock.group">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,16,0,6" />
      <Setter Property="Foreground" Value="{DynamicResource AppText}" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,10,0" />
      <Setter Property="Foreground" Value="{DynamicResource AppText}" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorder}" />
      <Setter Property="Background" Value="{DynamicResource AppSurface}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10" />
    </Style>

    <!--
      A rail row is a 3 px accent bar and a surface fill when it is the one showing, rather
      than a full accent tint: the selected row has to read as selected without shouting over
      the screen it selects.
    -->
    <Style Selector="Button.rail">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="11,9" />
      <Setter Property="Margin" Value="0,0,0,2" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="0,4,4,0" />
    </Style>
    <Style Selector="Button.rail.on">
      <Setter Property="Background" Value="{DynamicResource AppSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppAccent}" />
    </Style>
    <Style Selector="Button.rail TextBlock.name">
      <Setter Property="Foreground" Value="{DynamicResource AppText}" />
    </Style>
    <Style Selector="Button.rail TextBlock.note">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
  </UserControl.Styles>

  <DockPanel>

    <!-- The language belongs everywhere, so it stays findable when the rail cannot be read. -->
    <Border DockPanel.Dock="Top" Padding="16,10,16,6">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <TextBlock Classes="label"
                   Text="{Binding [UiLanguage], Source={x:Static loc:Loc.Current}}" />
        <ComboBox MinWidth="120"
                  ItemsSource="{x:Static vm:SettingsViewModel.Languages}"
                  SelectedItem="{Binding SelectedLanguage}"
                  DisplayMemberBinding="{Binding Name}" />
      </StackPanel>
    </Border>

    <!--
      The command that would do the same thing, while a run is being described. A run's own
      page carries the line that run stored, so an old run is repeatable as it actually was.
    -->
    <Border DockPanel.Dock="Bottom" Padding="16,10"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource AppCardBorder}"
            IsVisible="{Binding ShowingSetup}">
      <StackPanel>
        <TextBlock Classes="hint"
                   Text="{Binding [UiEquivalentCommand], Source={x:Static loc:Loc.Current}}" />
        <SelectableTextBlock Margin="0,2,0,0"
                             FontFamily="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace"
                             TextWrapping="Wrap"
                             Foreground="{DynamicResource AppTextSecondary}"
                             Text="{Binding Setup.CommandLine}" />
      </StackPanel>
    </Border>

    <!-- What a run can be looked at through, and the way back to setting one up. -->
    <Border DockPanel.Dock="Left" Width="200" Padding="8,6,8,10"
            BorderThickness="0,0,1,0"
            BorderBrush="{DynamicResource AppCardBorder}">
      <DockPanel>

        <Button DockPanel.Dock="Bottom" HorizontalAlignment="Stretch" Padding="12,9"
                Command="{Binding NewRunCommand}"
                Background="{DynamicResource AppAccent}"
                Foreground="{DynamicResource AppTextOnAccent}"
                HorizontalContentAlignment="Center"
                Content="{Binding [UiNewRun], Source={x:Static loc:Loc.Current}}" />

        <StackPanel DockPanel.Dock="Top">

          <Button Classes="rail" Classes.on="{Binding ShowingRuns}"
                  Command="{Binding ShowRunsCommand}">
            <StackPanel>
              <TextBlock Classes="name"
                         Text="{Binding [UiRailRuns], Source={x:Static loc:Loc.Current}}" />
              <TextBlock Classes="note" Text="{Binding Runs.Count}" />
            </StackPanel>
          </Button>

          <Button Classes="rail" Classes.on="{Binding ShowingSetup}"
                  Command="{Binding ShowSetupCommand}">
            <StackPanel>
              <TextBlock Classes="name"
                         Text="{Binding [UiRailSetup], Source={x:Static loc:Loc.Current}}" />
              <TextBlock Classes="note" Text="{Binding Setup.ChangedCount}" />
            </StackPanel>
          </Button>

          <Button Classes="rail" Classes.on="{Binding ShowingOpenRun}"
                  IsVisible="{Binding OpenRun, Converter={x:Static ObjectConverters.IsNotNull}}"
                  Command="{Binding ShowOpenRunCommand}">
            <StackPanel>
              <TextBlock Classes="name" Text="{Binding OpenRun.Name}" />
              <TextBlock Classes="note" Text="{Binding OpenRun.RailText}" />
            </StackPanel>
          </Button>

          <Button Classes="rail" Classes.on="{Binding ShowingSettings}"
                  Command="{Binding ShowSettingsCommand}">
            <TextBlock Classes="name"
                       Text="{Binding [UiSettings], Source={x:Static loc:Loc.Current}}" />
          </Button>

        </StackPanel>
      </DockPanel>
    </Border>

    <!--
      Resolved by the cached locator, which is what lets each screen keep its own view - and
      with it the log its scroll position - across every move of the rail.
    -->
    <ContentControl Margin="16,12" Content="{Binding Current}" />

  </DockPanel>

</UserControl>
