<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lego2STL.Gui.ViewModels"
             xmlns:loc="using:Lego2STL.Gui.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="560"
             x:Class="Lego2STL.Gui.Views.OptionsView"
             x:DataType="vm:MainViewModel">

  <UserControl.Styles>
    <Style Selector="TextBlock.opt">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,10,0" />
      <Setter Property="MinWidth" Value="170" />
    </Style>
    <Style Selector="StackPanel.row">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Margin" Value="0,3" />
    </Style>
    <Style Selector="NumericUpDown">
      <Setter Property="MinWidth" Value="150" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel Spacing="2" MaxWidth="820" HorizontalAlignment="Left">

      <TextBlock Classes="heading"
                 Text="{Binding [UiTabOptions], Source={x:Static loc:Loc.Current}}" />

      <!-- Stages -->
      <TextBlock Classes="group"
                 Text="{Binding [UiGroupStages], Source={x:Static loc:Loc.Current}}" />
      <StackPanel Classes="row">
        <CheckBox MinWidth="180" IsChecked="{Binding Options.CsvOnly}"
                  Content="--csv-only" />
        <TextBlock Classes="hint" VerticalAlignment="Center"
                   TextWrapping="Wrap" MaxWidth="580"
                   Text="{Binding [HelpOptCsvOnly], Source={x:Static loc:Loc.Current}}" />
      </StackPanel>
      <StackPanel Classes="row">
        <CheckBox MinWidth="180" IsChecked="{Binding Options.NoPlates}"
                  IsEnabled="{Binding Options.MakeShapes}"
                  Content="--no-plates" />
        <TextBlock Classes="hint" VerticalAlignment="Center"
                   TextWrapping="Wrap" MaxWidth="580"
                   Text="{Binding [HelpOptNoPlates], Source={x:Static loc:Loc.Current}}" />
      </StackPanel>

      <!-- Output -->
      <TextBlock Classes="group"
                 Text="{Binding [UiGroupOutput], Source={x:Static loc:Loc.Current}}" />
      <Grid ColumnDefinitions="180,*,Auto" Margin="0,3">
        <TextBlock Grid.Column="0" Classes="opt" Text="--output-dir"
                   ToolTip.Tip="{Binding [HelpOptOutputDir], Source={x:Static loc:Loc.Current}}" />
        <TextBox Grid.Column="1" Text="{Binding Options.OutputDirectory}" />
        <Button Grid.Column="2" Margin="8,0,0,0" Name="PickOutput"
                Content="{Binding [UiBrowse], Source={x:Static loc:Loc.Current}}" />
      </Grid>
      <StackPanel Classes="row">
        <TextBlock Classes="opt" Text="--delimiter"
                   ToolTip.Tip="{Binding [HelpOptDelimiter], Source={x:Static loc:Loc.Current}}" />
        <ComboBox MinWidth="150"
                  ItemsSource="{x:Static vm:RunOptionsViewModel.Delimiters}"
                  SelectedItem="{Binding Options.Delimiter}" />
      </StackPanel>
      <StackPanel Classes="row">
        <CheckBox MinWidth="180" IsChecked="{Binding Options.AsciiStl}"
                  Content="--ascii" />
        <TextBlock Classes="hint" VerticalAlignment="Center"
                   TextWrapping="Wrap" MaxWidth="580"
                   Text="{Binding [HelpOptAscii], Source={x:Static loc:Loc.Current}}" />
      </StackPanel>

      <!-- Geometry -->
      <TextBlock Classes="group"
                 Text="{Binding [UiGroupGeometry], Source={x:Static loc:Loc.Current}}" />
      <StackPanel Classes="row">
        <TextBlock Classes="opt" Text="--scale  (%)"
                   ToolTip.Tip="{Binding [HelpOptScale], Source={x:Static loc:Loc.Current}}" />
        <NumericUpDown Value="{Binding Options.ScalePercent}"
                       Minimum="1" Maximum="1000" Increment="5" FormatString="0.##" />
      </StackPanel>
      <StackPanel Classes="row">
        <TextBlock Classes="opt" Text="--clearance  (mm)"
                   ToolTip.Tip="{Binding [HelpOptClearance], Source={x:Static loc:Loc.Current}}" />
        <NumericUpDown Value="{Binding Options.Clearance}"
                       Minimum="0" Maximum="5" Increment="0.05" FormatString="0.###" />
      </StackPanel>
      <StackPanel Classes="row">
        <CheckBox MinWidth="180" IsChecked="{Binding Options.FillGaps}"
                  Content="--repair" />
        <TextBlock Classes="hint" VerticalAlignment="Center"
                   TextWrapping="Wrap" MaxWidth="580"
                   Text="{Binding [HelpOptRepair], Source={x:Static loc:Loc.Current}}" />
      </StackPanel>
      <StackPanel Classes="row">
        <CheckBox MinWidth="180" IsChecked="{Binding Options.KeepOrigin}"
                  Content="--keep-origin" />
        <TextBlock Classes="hint" VerticalAlignment="Center"
                   TextWrapping="Wrap" MaxWidth="580"
                   Text="{Binding [HelpOptKeepOrigin], Source={x:Static loc:Loc.Current}}" />
      </StackPanel>
      <StackPanel Classes="row">
        <CheckBox MinWidth="180" IsChecked="{Binding Options.NoSeamRepair}"
                  Content="--no-seam-repair" />
        <TextBlock Classes="hint" VerticalAlignment="Center"
                   TextWrapping="Wrap" MaxWidth="580"
                   Text="{Binding [HelpOptNoSeamRepair], Source={x:Static loc:Loc.Current}}" />
      </StackPanel>
      <StackPanel Classes="row">
        <TextBlock Classes="opt" Text="--weld-tolerance  (mm)"
                   ToolTip.Tip="{Binding [HelpOptWeldTolerance], Source={x:Static loc:Loc.Current}}" />
        <NumericUpDown Value="{Binding Options.WeldTolerance}"
                       Minimum="0" Maximum="1" Increment="0.001" FormatString="0.####" />
      </StackPanel>

      <!-- Shape library -->
      <TextBlock Classes="group"
                 Text="{Binding [UiGroupLibrary], Source={x:Static loc:Loc.Current}}" />
      <Grid ColumnDefinitions="180,*,Auto" Margin="0,3">
        <TextBlock Grid.Column="0" Classes="opt" Text="--ldraw-dir"
                   ToolTip.Tip="{Binding [HelpOptLDrawDir], Source={x:Static loc:Loc.Current}}" />
        <TextBox Grid.Column="1" Text="{Binding Options.LDrawDirectory}" />
        <Button Grid.Column="2" Margin="8,0,0,0" Name="PickLDraw"
                Content="{Binding [UiBrowse], Source={x:Static loc:Loc.Current}}" />
      </Grid>
      <Grid ColumnDefinitions="180,*,Auto" Margin="0,3">
        <TextBlock Grid.Column="0" Classes="opt" Text="--ldraw-cache"
                   ToolTip.Tip="{Binding [HelpOptLDrawCache], Source={x:Static loc:Loc.Current}}" />
        <TextBox Grid.Column="1" Text="{Binding Options.LDrawCache}" />
        <Button Grid.Column="2" Margin="8,0,0,0" Name="PickCache"
                Content="{Binding [UiBrowse], Source={x:Static loc:Loc.Current}}" />
      </Grid>
      <StackPanel Classes="row">
        <CheckBox MinWidth="180" IsChecked="{Binding Options.Offline}"
                  Content="--offline" />
        <TextBlock Classes="hint" VerticalAlignment="Center"
                   TextWrapping="Wrap" MaxWidth="580"
                   Text="{Binding [HelpOptOffline], Source={x:Static loc:Loc.Current}}" />
      </StackPanel>
      <StackPanel Classes="row">
        <CheckBox MinWidth="180" IsChecked="{Binding Options.NoUnofficial}"
                  Content="--no-unofficial" />
        <TextBlock Classes="hint" VerticalAlignment="Center"
                   TextWrapping="Wrap" MaxWidth="580"
                   Text="{Binding [HelpOptNoUnofficial], Source={x:Static loc:Loc.Current}}" />
      </StackPanel>

      <!-- Plates -->
      <TextBlock Classes="group"
                 Text="{Binding [UiGroupPlates], Source={x:Static loc:Loc.Current}}" />
      <StackPanel Classes="row">
        <TextBlock Classes="opt" Text="--printer"
                   ToolTip.Tip="{Binding [HelpOptPrinter], Source={x:Static loc:Loc.Current}}" />
        <ComboBox MinWidth="150"
                  IsEnabled="{Binding Options.MakePlates}"
                  ItemsSource="{x:Static vm:RunOptionsViewModel.Printers}"
                  SelectedItem="{Binding Options.Printer}" />
      </StackPanel>
      <StackPanel Classes="row">
        <TextBlock Classes="opt" Text="--plate-size"
                   ToolTip.Tip="{Binding [HelpOptPlateSize], Source={x:Static loc:Loc.Current}}" />
        <TextBox MinWidth="150" PlaceholderText="220x220"
                 IsEnabled="{Binding Options.MakePlates}"
                 Text="{Binding Options.PlateSize}" />
        <TextBlock Classes="hint" VerticalAlignment="Center" Margin="10,0,0,0"
                   Text="{Binding [HelpOptPlateSize], Source={x:Static loc:Loc.Current}}" />
      </StackPanel>
      <StackPanel Classes="row">
        <TextBlock Classes="opt" Text="--plate-spacing  (mm)"
                   ToolTip.Tip="{Binding [HelpOptPlateSpacing], Source={x:Static loc:Loc.Current}}" />
        <NumericUpDown Value="{Binding Options.PlateSpacing}"
                       IsEnabled="{Binding Options.MakePlates}"
                       Minimum="0" Maximum="50" Increment="0.5" FormatString="0.##" />
      </StackPanel>

      <!-- Behaviour -->
      <TextBlock Classes="group"
                 Text="{Binding [UiGroupBehaviour], Source={x:Static loc:Loc.Current}}" />
      <StackPanel Classes="row">
        <TextBlock Classes="opt"
                   Text="{Binding [UiLanguage], Source={x:Static loc:Loc.Current}}" />
        <ComboBox MinWidth="150"
                  ItemsSource="{Binding Languages}"
                  SelectedItem="{Binding SelectedLanguage}"
                  DisplayMemberBinding="{Binding Name}" />
        <TextBlock Classes="hint" VerticalAlignment="Center" Margin="10,0,0,0"
                   Text="{Binding [HelpOptLang], Source={x:Static loc:Loc.Current}}" />
      </StackPanel>
      <Grid ColumnDefinitions="180,*" Margin="0,3">
        <TextBlock Grid.Column="0" Classes="opt" Text="--api-key"
                   ToolTip.Tip="{Binding [HelpOptApiKey], Source={x:Static loc:Loc.Current}}" />
        <TextBox Grid.Column="1" PasswordChar="•" Text="{Binding Options.ApiKey}"
                 PlaceholderText="{Binding [HelpOptApiKey], Source={x:Static loc:Loc.Current}}" />
      </Grid>
      <Grid ColumnDefinitions="180,*,Auto" Margin="0,3">
        <TextBlock Grid.Column="0" Classes="opt" Text="--log"
                   ToolTip.Tip="{Binding [HelpOptLog], Source={x:Static loc:Loc.Current}}" />
        <TextBox Grid.Column="1" Text="{Binding Options.LogFile}" />
        <Button Grid.Column="2" Margin="8,0,0,0" Name="PickLog"
                Content="{Binding [UiBrowse], Source={x:Static loc:Loc.Current}}" />
      </Grid>

      <TextBlock Classes="hint" Margin="0,18,0,0" TextWrapping="Wrap"
                 Text="{Binding [UiEveryOptionHere], Source={x:Static loc:Loc.Current}}" />

    </StackPanel>
  </ScrollViewer>

</UserControl>
