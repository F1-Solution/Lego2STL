<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lego2STL.Gui.ViewModels"
             xmlns:loc="using:Lego2STL.Gui.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="Lego2STL.Gui.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <UserControl.Styles>
    <!-- Named for a reader, with the flag kept beside it for anyone asking from a terminal. -->
    <Style Selector="StackPanel.name">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Width" Value="170" />
      <Setter Property="Spacing" Value="1" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource AppText}" />
    </Style>
    <Style Selector="TextBlock.flag">
      <Setter Property="FontFamily" Value="Consolas, Menlo, monospace" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="{DynamicResource AppSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorder}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel Spacing="10" MaxWidth="760" HorizontalAlignment="Left">

      <TextBlock Classes="heading"
                 Text="{Binding [UiSettings], Source={x:Static loc:Loc.Current}}" />

      <!-- The window's language, and its one home. -->
      <Border Classes="card">
        <Grid ColumnDefinitions="Auto,Auto,*">
          <StackPanel Grid.Column="0" Classes="name">
            <TextBlock Classes="label"
                       Text="{Binding [LabelOptLang], Source={x:Static loc:Loc.Current}}" />
            <TextBlock Classes="flag" Text="--lang" />
          </StackPanel>
          <ComboBox Grid.Column="1" MinWidth="200"
                    ItemsSource="{x:Static vm:SettingsViewModel.Languages}"
                    SelectedItem="{Binding SelectedLanguage}" />
          <TextBlock Grid.Column="2" Classes="help" Margin="12,0,0,0"
                     VerticalAlignment="Center" TextWrapping="Wrap"
                     Foreground="{DynamicResource AppTextSecondary}"
                     Text="{Binding [HelpOptLang], Source={x:Static loc:Loc.Current}}" />
        </Grid>
      </Border>

      <!-- The key for looking a set up. Named here and never printed into the shown command. -->
      <Border Classes="card">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel Grid.Column="0" Classes="name">
            <TextBlock Classes="label"
                       Text="{Binding [LabelOptApiKey], Source={x:Static loc:Loc.Current}}" />
            <TextBlock Classes="flag" Text="--api-key" />
          </StackPanel>
          <TextBox Grid.Column="1" PasswordChar="•" VerticalAlignment="Center"
                   Text="{Binding Options.ApiKey}" />
          <TextBlock Grid.Column="2" Margin="12,0,0,0"
                     VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="320"
                     Foreground="{DynamicResource AppTextSecondary}"
                     Text="{Binding [HelpOptApiKey], Source={x:Static loc:Loc.Current}}" />
        </Grid>
      </Border>

      <!-- Where everything a run said is kept. -->
      <Border Classes="card">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
          <StackPanel Grid.Column="0" Classes="name">
            <TextBlock Classes="label"
                       Text="{Binding [LabelOptLog], Source={x:Static loc:Loc.Current}}" />
            <TextBlock Classes="flag" Text="--log" />
          </StackPanel>
          <TextBox Grid.Column="1" VerticalAlignment="Center" Text="{Binding Options.LogFile}" />
          <Button Grid.Column="2" Margin="8,0,0,0" Name="PickLog"
                  Content="{Binding [UiBrowse], Source={x:Static loc:Loc.Current}}" />
          <TextBlock Grid.Column="3" Margin="12,0,0,0"
                     VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="240"
                     Foreground="{DynamicResource AppTextSecondary}"
                     Text="{Binding [HelpOptLog], Source={x:Static loc:Loc.Current}}" />
        </Grid>
      </Border>

      <!-- Whether a run says anything on screen while it happens. -->
      <Border Classes="card">
        <Grid ColumnDefinitions="Auto,Auto,*">
          <StackPanel Grid.Column="0" Classes="name">
            <TextBlock Classes="label"
                       Text="{Binding [LabelOptQuiet], Source={x:Static loc:Loc.Current}}" />
            <TextBlock Classes="flag" Text="--quiet" />
          </StackPanel>
          <CheckBox Grid.Column="1" VerticalAlignment="Center"
                    IsChecked="{Binding Options.Quiet}" />
          <TextBlock Grid.Column="2" Margin="12,0,0,0"
                     VerticalAlignment="Center" TextWrapping="Wrap"
                     Foreground="{DynamicResource AppTextSecondary}"
                     Text="{Binding [HelpOptQuiet], Source={x:Static loc:Loc.Current}}" />
        </Grid>
      </Border>

      <!-- The history, not the folders: nothing on the disk is touched. -->
      <Border Classes="card">
        <StackPanel Spacing="8">
          <Button HorizontalAlignment="Left"
                  Command="{Binding ForgetEveryRunCommand}"
                  Content="{Binding [UiForgetEverything], Source={x:Static loc:Loc.Current}}" />
          <TextBlock TextWrapping="Wrap"
                     Foreground="{DynamicResource AppTextSecondary}"
                     Text="{Binding [UiRunsEmpty], Source={x:Static loc:Loc.Current}}" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="label"
                     Text="{Binding [UiShops], Source={x:Static loc:Loc.Current}}" />
          <TextBlock Classes="flag" TextWrapping="Wrap"
                     Text="{Binding [UiShopHelp], Source={x:Static loc:Loc.Current}}" />

          <ItemsControl ItemsSource="{Binding ShopRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ShopRowViewModel">
                <Grid ColumnDefinitions="Auto,150,*,Auto" Margin="0,0,0,6">
                  <RadioButton Grid.Column="0" GroupName="PreferredShop" VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               ToolTip.Tip="{Binding [UiPreferredShop], Source={x:Static loc:Loc.Current}}"
                               IsChecked="{Binding IsPreferred, Mode=TwoWay}" />
                  <TextBox Grid.Column="1" Margin="0,0,6,0" Text="{Binding Name}" />
                  <TextBox Grid.Column="2" Margin="0,0,6,0" Text="{Binding Url}" />
                  <Button Grid.Column="3"
                          Content="{Binding [UiRemoveShop], Source={x:Static loc:Loc.Current}}"
                          Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RemoveShopCommand}"
                          CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Button HorizontalAlignment="Left"
                  Content="{Binding [UiAddShop], Source={x:Static loc:Loc.Current}}"
                  Command="{Binding AddShopCommand}" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="label"
                     Text="{Binding [UiTolerances], Source={x:Static loc:Loc.Current}}" />

          <ItemsControl ItemsSource="{Binding ToleranceRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ToleranceRowViewModel">
                <Grid ColumnDefinitions="Auto,*,120,Auto" Margin="0,0,0,6">
                  <RadioButton Grid.Column="0" GroupName="PreferredTolerance" VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               IsChecked="{Binding IsPreferred, Mode=TwoWay}" />
                  <TextBox Grid.Column="1" Margin="0,0,6,0"
                           PlaceholderText="{Binding [UiToleranceName], Source={x:Static loc:Loc.Current}}"
                           Text="{Binding Name}" />
                  <NumericUpDown Grid.Column="2" Margin="0,0,6,0"
                                 Value="{Binding Millimetres}"
                                 Minimum="0" Increment="0.05" FormatString="0.00" />
                  <Button Grid.Column="3"
                          Content="{Binding [UiRemoveTolerance], Source={x:Static loc:Loc.Current}}"
                          Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RemoveToleranceCommand}"
                          CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Button HorizontalAlignment="Left"
                  Content="{Binding [UiAddTolerance], Source={x:Static loc:Loc.Current}}"
                  Command="{Binding AddToleranceCommand}" />

          <Button HorizontalAlignment="Left"
                  Content="{Binding [UiRunCalibration], Source={x:Static loc:Loc.Current}}"
                  Command="{Binding RunCalibrationCommand}" />
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
