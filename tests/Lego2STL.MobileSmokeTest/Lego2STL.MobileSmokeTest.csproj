<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      The three mobile targets prove the fixture builds and runs where it matters; the
      windows target has nothing platform-specific to build (all three host files are
      excluded from it below) and exists only so Lego2STL.Tests has something to reference
      for SmokeFixtureTests, which exercises the fixture where it can be debugged.
    -->
    <TargetFrameworks>$(MobileTargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType Condition="'$(TargetFramework)' != 'net10.0-windows10.0.19041.0'">Exe</OutputType>
    <ApplicationTitle>Lego2STL Mobile Smoke Test</ApplicationTitle>
    <ApplicationId>com.lego2stl.pipelinesmoketest</ApplicationId>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsAndroidTarget)' != 'true'">
    <Compile Remove="Platforms\Android\**\*.cs" />
  </ItemGroup>

  <PropertyGroup Condition="'$(IsAndroidTarget)' == 'true'">
    <!--
      Not the default root location: this project's manifest lives beside its other
      per-platform files, so the SDK has to be told where to find it.
    -->
    <AndroidManifest>Platforms\Android\AndroidManifest.xml</AndroidManifest>
    <!--
      Must match the manifest's own minSdkVersion exactly, or the SDK refuses to build.
      24, not the SDK's own default of 21: a transitive ML Kit dependency
      (androidx.lifecycle.runtime) needs 23 or higher.
    -->
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup Condition="!$(TargetFramework.Contains('-ios'))">
    <Compile Remove="Platforms\iOS\**\*.cs" />
  </ItemGroup>

  <PropertyGroup Condition="$(TargetFramework.Contains('-ios'))">
    <!-- Not the default root location: this project's Info.plist lives with its other iOS files. -->
    <InfoPlist>Platforms\iOS\Info.plist</InfoPlist>
  </PropertyGroup>

  <ItemGroup Condition="!$(TargetFramework.Contains('-macos'))">
    <Compile Remove="Platforms\MacOS\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Lego2STL.Core\Lego2STL.Core.csproj" />
  </ItemGroup>

</Project>
